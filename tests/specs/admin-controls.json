[
  {
    "name": "/set_welcome saves a concise greeting",
    "steps": [
      { "send": { "text": "/set_welcome Welcome aboard." }, "expect": [{ "method": "sendMessage", "payload": { "text": "Your welcome message is saved." } }] }
    ]
  },
  {
    "name": "/set_rules saves group rules",
    "steps": [
      { "send": { "text": "/set_rules Keep discussion respectful." }, "expect": [{ "method": "sendMessage", "payload": { "text": "Your group rules are saved." } }] }
    ]
  },
  {
    "name": "/view_log has a clear empty state",
    "steps": [
      { "send": { "text": "/view_log" }, "expect": [{ "method": "sendMessage", "payload": { "text": "No moderation actions have been recorded yet." } }] }
    ]
  },
